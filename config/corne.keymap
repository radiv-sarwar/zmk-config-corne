#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        homerow: homerow {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <300>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BaseLayer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB       &kp Q                &kp W                &kp E                  &kp R                    &kp T        &kp Y          &kp U                    &kp I                  &kp O                &kp P                         &kp GRAVE
&kp ESCAPE    &homerow LEFT_GUI A  &homerow LEFT_ALT S  &homerow LEFT_SHIFT D  &homerow LEFT_CONTROL F  &kp G        &kp H          &homerow LEFT_CONTROL J  &homerow LEFT_SHIFT K  &homerow LEFT_ALT L  &homerow RIGHT_GUI SEMICOLON  &kp SQT
&kp CAPSLOCK  &kp Z                &kp X                &kp C                  &kp V                    &kp B        &kp N          &kp M                    &kp COMMA              &kp DOT              &kp FSLH                      &kp BACKSLASH
                                                        &none                  &mo 1                    &kp SPACE    &kp BACKSPACE  &kp ENTER                &tog 2
            >;
        };

        Symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none   &kp EXCL  &kp AT_SIGN  &kp HASH      &kp DOLLAR  &kp PERCENT    &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS  &kp EQUAL    &kp BACKSLASH
&none   &trans    &trans       &kp UP_ARROW  &trans      &kp CARET      &kp AMPERSAND  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp UNDER  &kp PLUS     &none
&trans  &none     &kp LEFT     &kp DOWN      &kp RIGHT   &none          &none          &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &none      &kp PAGE_UP  &kp PAGE_DOWN
                               &kp DELETE    &trans      &kp SPACE      &kp BACKSPACE  &kp ENTER             &tog 2
            >;
        };

        NumpadLayer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans       &trans         &kp N7        &kp N8        &kp N9        &kp PLUS    &kp MINUS
&trans          &trans  &trans  &trans  &trans  &trans       &trans         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTRK   &kp KP_DIVIDE
&trans          &trans  &trans  &trans  &trans  &trans       &kp NUMBER_0   &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &kp EQUAL
                                &trans  &trans  &kp SPACE    &kp BACKSPACE  &kp ENTER     &tog 2
            >;
        };
    };
};
